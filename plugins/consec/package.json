{
  "name": "@consec/backstage-plugin-consec",
  "version": "0.1.0",
  "description": "A Backstage plugin that shows ConSec@SK container security for catalog entities",
  "backstage": {
    "role": "frontend-plugin",
    "pluginId": "consec",
    "pluginPackages": [
      "@consec/backstage-plugin-consec"
    ]
  },
  "publishConfig": {
    "access": "public",
    "main": "dist/index.esm.js",
    "types": "dist/index.d.ts"
  },
  "keywords": [
    "backstage",
    "consec",
    "container-security"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/SCK2008/consec-plugin",
    "directory": "plugins/consec"
  },
  "license": "Apache-2.0",
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts",
    "./alpha": "./src/alpha.tsx",
    "./package.json": "./package.json"
  },
  "main": "src/index.ts",
  "types": "src/index.ts",
  "typesVersions": {
    "*": {
      "alpha": [
        "src/alpha.tsx"
      ],
      "package.json": [
        "package.json"
      ]
    }
  },
  "files": [
    "dist",
    "config.d.ts"
  ],
  "configSchema": "config.d.ts",
  "scripts": {
    "build": "backstage-cli package build",
    "clean": "backstage-cli package clean",
    "lint": "backstage-cli package lint",
    "prepack": "backstage-cli package prepack",
    "postpack": "backstage-cli package postpack",
    "start": "backstage-cli package start",
    "test": "backstage-cli package test"
  },
  "dependencies": {
    "@backstage/catalog-model": "^1.10.0",
    "@backstage/core-components": "^0.18.13",
    "@backstage/core-plugin-api": "^1.12.9",
    "@backstage/errors": "^1.3.2",
    "@backstage/frontend-plugin-api": "^0.18.0",
    "@backstage/plugin-catalog-react": "^3.2.1",
    "@material-ui/core": "^4.12.2",
    "@material-ui/lab": "4.0.0-alpha.61",
    "luxon": "^3.4.3",
    "p-limit": "^3.1.0",
    "react-use": "^17.2.4"
  },
  "devDependencies": {
    "@backstage/cli": "^0.36.5",
    "@backstage/core-app-api": "^1.20.4",
    "@backstage/dev-utils": "^1.1.28",
    "@backstage/frontend-test-utils": "^0.6.5",
    "@backstage/test-utils": "^1.7.21",
    "@jest/environment-jsdom-abstract": "~30.2.0",
    "@testing-library/dom": "^10.0.0",
    "@testing-library/jest-dom": "^6.0.0",
    "@testing-library/react": "^16.0.0",
    "@types/jest": "^30.0.0",
    "@types/react": "^18.0.0",
    "@types/react-dom": "^18.2.19",
    "jest": "~30.2.0",
    "jsdom": "^27.1.0",
    "msw": "^1.3.5",
    "react": "^18.0.2",
    "react-dom": "^18.0.2",
    "react-router-dom": "^6.30.2"
  },
  "peerDependencies": {
    "react": "^18.0.2",
    "react-dom": "^18.0.2",
    "react-router-dom": "^6.30.2"
  }
}
